# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=<your-project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey_<your-anon-key-here>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_<your-publishable-default-key-here>
SUPABASE_SECRET_KEY=sb_secret_<your-secret-key-here>

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
# run `npx auth secret` to generate a secure secret
# NextAuth v5 uses AUTH_SECRET, but NEXTAUTH_SECRET is also supported for backwards compatibility
AUTH_SECRET="<your-auth-secret-here>"
NEXTAUTH_SECRET="<your-nextauth-secret-here>"

# App Settings
NEXT_PUBLIC_APP_NAME="Hope's Corner"
# Set to false for an immediate rollback to the legacy check-in loader.
CHECKIN_V2_ENABLED=true
# Holiday toy distribution month and day (MM-DD). The year comes from the
# current system date, so only update this when the event day changes.
# Enables the confirmation-page date and Add to Calendar button.
# NEXT_PUBLIC_HOLIDAY_EVENT_MONTH_DAY=12-20


# ------------------------------------------------------------------------------
# OPTIONAL - Development Settings
# ------------------------------------------------------------------------------

# Set to 'development' or 'production'
# NODE_ENV=development

# Enable verbose logging (optional)
# DEBUG=true
